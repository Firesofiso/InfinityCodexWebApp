# Copy this to .env on the server and fill in real values.
# NEVER commit .env to git.

# GitHub repository in owner/repo format — used to pull the right image
GITHUB_REPOSITORY=your-github-username/infinity-codex

# SQLite — path inside the container, mapped to ./data on the host
ConnectionStrings__DefaultConnection=Data Source=/app/data/infinitycodex.db
Database__Provider=Sqlite

# Discord OAuth
DiscordOAuth__ClientId=
DiscordOAuth__ClientSecret=
DiscordOAuth__RedirectUri=https://YOUR_DOMAIN/auth/discord/callback
DiscordOAuth__RegistrationGuildId=
DiscordOAuth__Scope=identify email guilds.members.read
DiscordOAuth__Prompt=consent

# Must match the public URL so auth cookie domain and CORS are correct
Frontend__BaseUrl=https://YOUR_DOMAIN/

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
